---
import { siteConfig } from '../site.config';
const year = new Date().getUTCFullYear();
---

<footer class="mt-20 border-t border-zinc-200 py-8 text-xs text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
  <div class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-4 px-4 sm:flex-row sm:items-center sm:px-6">
    <p class="font-mono">
      © {year} {siteConfig.author} · Built with Astro
    </p>
    <div class="flex items-center gap-4 font-mono">
      {
        siteConfig.social.github && (
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-sky-600 dark:hover:text-sky-400"
          >
            GitHub
          </a>
        )
      }
      <a
        href={siteConfig.social.rss}
        class="transition-colors hover:text-sky-600 dark:hover:text-sky-400"
      >
        RSS
      </a>
      <a
        href="/sitemap-index.xml"
        class="transition-colors hover:text-sky-600 dark:hover:text-sky-400"
      >
        Sitemap
      </a>
    </div>
  </div>
</footer>
