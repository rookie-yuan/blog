---
import {
  calculateReadingTime,
  encodeTagSlug,
  formatDate,
  getPostSlug,
  type BlogPostLike,
} from '../utils/posts';

interface Props {
  post: BlogPostLike;
}

const { post } = Astro.props;
const slug = getPostSlug(post.id);
const readingTime = calculateReadingTime(post.body ?? '');
---

<article
  data-post-card
  data-category={post.data.category}
  class="group flex flex-col justify-between rounded-lg border border-zinc-200 bg-white p-5 transition-colors hover:border-sky-600 dark:border-zinc-800 dark:bg-zinc-900/60 dark:hover:border-sky-400"
>
  <div>
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-zinc-500 dark:text-zinc-400">
      <time datetime={formatDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
      <span>·</span>
      <span>{readingTime} min</span>
      <span>·</span>
      <span class="text-sky-600 dark:text-sky-400">{post.data.category}</span>
      {
        post.data.pinned && (
          <span class="ml-auto rounded border border-sky-600/30 bg-sky-50 px-1.5 py-0.5 text-[10px] font-medium text-sky-700 dark:border-sky-400/30 dark:bg-sky-950/60 dark:text-sky-300">
            PINNED
          </span>
        )
      }
    </div>

    <h2 class="mt-3 text-lg font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-sky-600 dark:text-zinc-100 dark:group-hover:text-sky-400">
      <a href={`/posts/${slug}/`} class="block">
        {post.data.title}
      </a>
    </h2>

    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      {post.data.description}
    </p>
  </div>

  {
    post.data.tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <a
            href={`/tags/${encodeURIComponent(encodeTagSlug(tag))}/`}
            class="rounded border border-zinc-200 bg-zinc-50 px-2 py-0.5 font-mono text-[11px] text-zinc-600 transition-colors hover:border-sky-600 hover:text-sky-600 dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-400 dark:hover:border-sky-400 dark:hover:text-sky-400"
          >
            #{tag}
          </a>
        ))}
      </div>
    )
  }
</article>
