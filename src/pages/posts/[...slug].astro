---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import {
  calculateReadingTime,
  filterPublishedPosts,
  getPostSlug,
  sortPosts,
} from '../../utils/posts';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const posts = sortPosts(filterPublishedPosts(allPosts, import.meta.env.DEV));

  return posts.map((post, index) => {
    const slug = getPostSlug(post.id);
    const prev = index < posts.length - 1 ? posts[index + 1] : undefined;
    const next = index > 0 ? posts[index - 1] : undefined;

    return {
      params: { slug },
      props: {
        post,
        prevPost: prev
          ? { slug: getPostSlug(prev.id), title: prev.data.title }
          : undefined,
        nextPost: next
          ? { slug: getPostSlug(next.id), title: next.data.title }
          : undefined,
      },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = calculateReadingTime(post.body ?? '');
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
  tags={post.data.tags}
  readingTime={readingTime}
  headings={headings}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</PostLayout>
