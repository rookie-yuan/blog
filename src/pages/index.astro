---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { siteConfig } from '../site.config';
import { filterPublishedPosts, sortPosts } from '../utils/posts';

const allPosts = await getCollection('blog');
const posts = sortPosts(filterPublishedPosts(allPosts, import.meta.env.DEV));

const categoryCounts = new Map<string, number>();
for (const cat of siteConfig.categories) {
  categoryCounts.set(cat, 0);
}
for (const post of posts) {
  categoryCounts.set(
    post.data.category,
    (categoryCounts.get(post.data.category) ?? 0) + 1
  );
}
---

<BaseLayout>
  <section class="border-b border-zinc-200 pb-10 dark:border-zinc-800">
    <div class="font-mono text-xs text-sky-600 dark:text-sky-400">
      // {siteConfig.author} · {siteConfig.siteUrl.replace('https://', '')}
    </div>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50">
      你好，我是 {siteConfig.author}
    </h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
      {siteConfig.authorBio}
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-3 font-mono text-xs">
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-zinc-700 transition-colors hover:border-sky-600 hover:text-sky-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-sky-400 dark:hover:text-sky-400"
      >
        GitHub ↗
      </a>
      <a
        href={siteConfig.social.rss}
        class="rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-zinc-700 transition-colors hover:border-sky-600 hover:text-sky-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-sky-400 dark:hover:text-sky-400"
      >
        RSS 订阅
      </a>
      <a
        href="/about"
        class="rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-zinc-700 transition-colors hover:border-sky-600 hover:text-sky-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-sky-400 dark:hover:text-sky-400"
      >
        关于我 →
      </a>
    </div>
  </section>

  <section class="mt-8">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="文章分类筛选">
        <button
          type="button"
          data-filter-cat="全部"
          aria-pressed="true"
          class="filter-btn rounded-md border border-sky-600 bg-sky-50 px-3 py-1 font-mono text-xs font-medium text-sky-700 transition-colors dark:border-sky-400 dark:bg-sky-950/60 dark:text-sky-300"
        >
          全部 ({posts.length})
        </button>
        {
          siteConfig.categories.map((cat) => (
            <button
              type="button"
              data-filter-cat={cat}
              aria-pressed="false"
              class="filter-btn rounded-md border border-zinc-200 bg-white px-3 py-1 font-mono text-xs text-zinc-600 transition-colors hover:border-sky-600 hover:text-sky-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-sky-400 dark:hover:text-sky-400"
            >
              {cat} ({categoryCounts.get(cat) ?? 0})
            </button>
          ))
        }
      </div>

      <a
        href="/posts"
        class="font-mono text-xs text-zinc-500 transition-colors hover:text-sky-600 dark:text-zinc-400 dark:hover:text-sky-400"
      >
        查看全部文章 →
      </a>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2" data-posts-grid>
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-cat]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post-card]'));

  const activeClasses = [
    'border-sky-600',
    'bg-sky-50',
    'text-sky-700',
    'font-medium',
    'dark:border-sky-400',
    'dark:bg-sky-950/60',
    'dark:text-sky-300',
  ];
  const inactiveClasses = [
    'border-zinc-200',
    'bg-white',
    'text-zinc-600',
    'dark:border-zinc-800',
    'dark:bg-zinc-900',
    'dark:text-zinc-400',
  ];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filterCat || '全部';
      buttons.forEach((b) => {
        const isCurrent = b === btn;
        b.setAttribute('aria-pressed', String(isCurrent));
        activeClasses.forEach((c) => b.classList.toggle(c, isCurrent));
        inactiveClasses.forEach((c) => b.classList.toggle(c, !isCurrent));
      });

      cards.forEach((card) => {
        const match = target === '全部' || card.dataset.category === target;
        card.classList.toggle('hidden', !match);
      });
    });
  });
</script>
