---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import {
  collectTags,
  encodeTagSlug,
  filterPublishedPosts,
  sortPosts,
} from '../../utils/posts';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const published = sortPosts(filterPublishedPosts(allPosts, import.meta.env.DEV));
  const tags = collectTags(published);

  return tags.map((item) => ({
    params: { tag: item.slug },
    props: {
      tagName: item.tag,
      posts: published.filter((p) =>
        p.data.tags.some((t) => encodeTagSlug(t) === item.slug)
      ),
    },
  }));
}

const { tagName, posts } = Astro.props;
---

<BaseLayout title={`#${tagName}`} description={`标签 #${tagName} 下的全部文章`}>
  <header class="border-b border-zinc-200 pb-6 dark:border-zinc-800">
    <a
      href="/tags"
      class="font-mono text-xs text-zinc-500 transition-colors hover:text-sky-600 dark:hover:text-sky-400"
    >
      ← 返回全部标签
    </a>
    <h1 class="mt-2 font-mono text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
      #{tagName}
    </h1>
    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
      共 {posts.length} 篇相关文章。
    </p>
  </header>

  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
